            },
            "url": {
              "raw": "{{base_url}}/api/v1/validate/relationships",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "validate", "relationships"]
            },
            "description": "Focus only on semantic consistency with LLM analysis - compare rule-based vs LLM findings"
          },
          "response": []
        },
        {
          "name": "Compare: Rule-Based vs LLM Enhanced",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Store LLM-enhanced results for comparison",
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    pm.environment.set('llm_report_id', response.report_id);",
                  "    ",
                  "    // Count rule-based vs LLM findings",
                  "    const ruleBasedFindings = response.findings.filter(f => f.category !== 'llm_semantic_analysis');",
                  "    const llmFindings = response.findings.filter(f => f.category === 'llm_semantic_analysis');",
                  "    ",
                  "    console.log(`Rule-based findings: ${ruleBasedFindings.length}`);",
                  "    console.log(`LLM-enhanced findings: ${llmFindings.length}`);",
                  "    console.log(`Total findings: ${response.findings_count}`);",
                  "    ",
                  "    // Show LLM suggestions",
                  "    if (llmFindings.length > 0) {",
                  "        console.log('LLM Analysis Summary:');",
                  "        llmFindings.slice(0, 3).forEach((f, i) => {",
                  "            console.log(`${i+1}. ${f.title}`);",
                  "            console.log(`   Confidence: ${f.confidence_score}`);",
                  "            console.log(`   Suggested: ${f.suggested_action}`);",
                  "        });",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"entity_limit\": 200,\n  \"relationship_limit\": 1000,\n  \"check_bidirectional\": true,\n  \"check_mutual_exclusivity\": true,\n  \"check_hierarchies\": true,\n  \"check_semantic_consistency\": true,\n  \"enable_llm_analysis\": true\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/validate/relationships",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "validate", "relationships"]
            },
            "description": "Compare deterministic rule-based findings vs LLM-enhanced analysis on same data"
          },
          "response": []
        }
      ],
      "description": "Different validation configurations to test rule-based vs LLM-enhanced analysis"
