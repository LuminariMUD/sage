                  "        if (f.category !== 'semantic_appropriateness') return false;",
                  "        ",
                  "        const srcType = f.metadata?.source_entity_type;",
                  "        const tgtType = f.metadata?.target_entity_type;",
                  "        const title = f.title.toLowerCase();",
                  "        ",
                  "        return (srcType === 'ORGANIZATION' || srcType === 'FACTION') && ",
                  "               (tgtType === 'MATERIAL' || tgtType === 'OBJECT') ||",
                  "               title.includes('forgotten') || title.includes('drow') || ",
                  "               title.includes('lacquer') || title.includes('mushroom');",
                  "    });",
                  "    ",
                  "    console.log(`Found ${factionMaterialIssues.length} faction-material relationship issues`);",
                  "    ",
                  "    factionMaterialIssues.forEach(finding => {",
