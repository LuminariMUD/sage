    {
      "name": "2. Run Validation",
      "item": [
        {
          "name": "Full Relationship Validation with LLM",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Store the report_id for later use",
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    pm.environment.set('last_report_id', response.report_id);",
                  "    pm.environment.set('last_agent_id', response.agent_id);",
                  "    ",
                  "    // Display summary",
                  "    console.log(`Validation completed in ${response.execution_time_seconds}s`);",
                  "    console.log(`Found ${response.findings_count} findings`);",
                  "    console.log(`Severity breakdown: ${JSON.stringify(response.severity_counts)}`);",
                  "    ",
                  "    // Store some finding IDs if available",
                  "    if (response.findings.length > 0) {",
                  "        pm.environment.set('sample_finding_id', response.findings[0].finding_id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"entity_limit\": 1000,\n  \"relationship_limit\": 5000,\n  \"check_bidirectional\": true,\n  \"check_mutual_exclusivity\": true,\n  \"check_hierarchies\": true,\n  \"check_semantic_consistency\": true,\n  \"enable_llm_analysis\": true\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/validate/relationships",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "validate", "relationships"]
            },
            "description": "Run comprehensive relationship validation with all checks enabled, including LLM-enhanced semantic analysis"
