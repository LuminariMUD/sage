    {
      "name": "4. Human Review Workflow",
      "item": [
        {
          "name": "Get All Unreviewed Findings",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Store first finding ID for review testing",
                  "if (pm.response.code === 200) {",
                  "    const findings = pm.response.json();",
                  "    if (findings.length > 0) {",
                  "        pm.environment.set('unreviewed_finding_id', findings[0].finding_id);",
                  "        console.log(`Found ${findings.length} unreviewed findings`);",
                  "        console.log(`Sample finding: ${findings[0].title}`);",
                  "    } else {",
                  "        console.log('No unreviewed findings found');",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/validate/findings/unreviewed",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "validate", "findings", "unreviewed"]
            },
            "description": "Get all findings that need human review"
          },
          "response": []
        },
        {
          "name": "Get Critical/Error Findings Only",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/validate/findings/unreviewed?severity=error",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "validate", "findings", "unreviewed"],
              "query": [
                {
                  "key": "severity",
                  "value": "error",
                  "description": "Filter by severity: critical, error, warning, info"
                },
                {
                  "key": "category",
                  "value": "mutual_exclusivity",
                  "description": "Filter by category",
                  "disabled": true
                },
                {
                  "key": "limit",
                  "value": "50",
                  "description": "Limit number of results",
                  "disabled": true
                }
              ]
            },
            "description": "Get only high-priority findings that need immediate attention"
          },
          "response": []
        },
        {
          "name": "Get Bidirectional Issues",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/validate/findings/unreviewed?category=bidirectional_consistency",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "validate", "findings", "unreviewed"],
              "query": [
                {
                  "key": "category",
                  "value": "bidirectional_consistency",
                  "description": "Filter by category"
                }
              ]
            },
            "description": "Get findings related to missing bidirectional relationships"
          },
          "response": []
        },
        {
          "name": "Get LLM-Enhanced Findings Only",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/validate/findings/unreviewed?category=llm_semantic_analysis",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "validate", "findings", "unreviewed"],
              "query": [
                {
                  "key": "category",
                  "value": "llm_semantic_analysis",
                  "description": "Filter for LLM-enhanced findings only"
                },
                {
                  "key": "limit",
                  "value": "25",
                  "description": "Limit LLM findings",
                  "disabled": true
                }
              ]
            },
            "description": "Get only LLM-enhanced semantic analysis findings for human review"
          },
          "response": []
        },
        {
          "name": "Compare Rule-Based vs LLM Findings",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Analyze and compare findings",
                  "if (pm.response.code === 200) {",
                  "    const findings = pm.response.json();",
                  "    ",
                  "    // Separate rule-based from LLM findings",
                  "    const ruleBasedFindings = findings.filter(f => f.category !== 'llm_semantic_analysis');",
                  "    const llmFindings = findings.filter(f => f.category === 'llm_semantic_analysis');",
                  "    ",
                  "    console.log('=== FINDINGS COMPARISON ===');",
                  "    console.log(`Rule-based findings: ${ruleBasedFindings.length}`);",
                  "    console.log(`LLM-enhanced findings: ${llmFindings.length}`);",
                  "    ",
                  "    // Show confidence distribution for LLM findings",
                  "    if (llmFindings.length > 0) {",
                  "        const highConf = llmFindings.filter(f => f.confidence_score >= 0.7).length;",
                  "        const medConf = llmFindings.filter(f => f.confidence_score >= 0.5 && f.confidence_score < 0.7).length;",
                  "        const lowConf = llmFindings.filter(f => f.confidence_score < 0.5).length;",
                  "        ",
                  "        console.log('LLM Confidence Distribution:');",
                  "        console.log(`  High (≥0.7): ${highConf}`);",
                  "        console.log(`  Medium (0.5-0.69): ${medConf}`);",
                  "        console.log(`  Low (<0.5): ${lowConf}`);",
                  "    }",
                  "    ",
                  "    // Show top LLM suggestions",
                  "    console.log('\\n=== TOP LLM SUGGESTIONS ===');",
                  "    llmFindings",
                  "        .sort((a, b) => b.confidence_score - a.confidence_score)",
                  "        .slice(0, 3)",
                  "        .forEach((f, i) => {",
                  "            console.log(`${i+1}. ${f.title.substring(0, 60)}...`);",
                  "            console.log(`   Confidence: ${f.confidence_score} | Priority: ${f.priority}`);",
                  "            console.log(`   Action: ${f.suggested_action.substring(0, 80)}...`);",
                  "        });",
                  "}",
                  ""
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/validate/findings/unreviewed?limit=100",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "validate", "findings", "unreviewed"],
              "query": [
                {
                  "key": "limit",
                  "value": "100",
                  "description": "Get more findings for comparison"
                }
              ]
            },
            "description": "Get all findings and compare rule-based vs LLM analysis with statistics"
          },
          "response": []
        }
      ],
      "description": "Find and filter unreviewed findings, including LLM-enhanced analysis"
