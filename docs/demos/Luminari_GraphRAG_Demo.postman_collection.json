{
  "info": {
    "_postman_id": "12345678-1234-1234-1234-123456789012",
    "name": "Luminari GraphRAG Demo (Authenticated)",
    "description": "Demonstration of the Luminari MUD Hybrid Graph RAG System combining semantic search with knowledge graph traversal. Uses API key authentication.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      {
        "key": "key",
        "value": "X-API-Key",
        "type": "string"
      },
      {
        "key": "value",
        "value": "{{SAGE_MCP_KEY}}",
        "type": "string"
      },
      {
        "key": "in",
        "value": "header",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "SAGE_API_KEY",
      "value": "your-sage-api-key-here",
      "type": "string",
      "description": "API key for direct API access"
    },
    {
      "key": "SAGE_MCP_KEY",
      "value": "your-sage-mcp-key-here",
      "type": "string",
      "description": "API key for MCP operations"
    },
    {
      "key": "base_url",
      "value": "https://luminarimud.com/sage",
      "type": "string",
      "description": "Base URL for Luminari Sage API"
    }
  ],
  "item": [
    {
      "name": "1. GraphRAG Query - Void's Wake",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/mcp/tools/call",
          "host": ["{{base_url}}"],
          "path": ["mcp", "tools", "call"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"query_lore\",\n  \"arguments\": {\n    \"query\": \"What is Void's Wake? Tell me about this mysterious location\",\n    \"max_results\": 4,\n    \"threshold\": 0.2\n  }\n}"
        },
        "description": "Demonstrates hybrid RAG: semantic search + graph traversal for rich context about Void's Wake location"
      }
    },
    {
      "name": "2. GraphRAG Query - Forgotten Tide Pirates",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/mcp/tools/call",
          "host": ["{{base_url}}"],
          "path": ["mcp", "tools", "call"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"query_lore\",\n  \"arguments\": {\n    \"query\": \"Tell me about the Forgotten Tide pirate faction and their operations\",\n    \"max_results\": 3,\n    \"threshold\": 0.3\n  }\n}"
        },
        "description": "Shows how GraphRAG finds relevant text chunks AND discovers related entities through graph connections"
      }
    },
