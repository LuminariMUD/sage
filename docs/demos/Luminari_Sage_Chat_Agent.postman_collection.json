{
  "info": {
    "_postman_id": "87654321-4321-4321-4321-210987654321",
    "name": "Luminari Sage Chat Agent",
    "description": "Interactive chat agent for exploring Luminari MUD lore through natural conversation with streaming responses, conversation management, and authentication.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "1.0.0"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      {
        "key": "key",
        "value": "X-API-Key",
        "type": "string"
      },
      {
        "key": "value",
        "value": "{{SAGE_API_KEY}}",
        "type": "string"
      },
      {
        "key": "in",
        "value": "header",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "SAGE_API_KEY",
      "value": "your-sage-api-key-here",
      "type": "string",
      "description": "API key for chat agent and API access"
    },
    {
      "key": "base_url",
      "value": "https://luminarimud.com/sage",
      "type": "string",
      "description": "Base URL for Luminari Sage API"
    },
    {
      "key": "conversation_id",
      "value": "",
      "type": "string",
      "description": "Current conversation ID (auto-populated)"
    },
    {
      "key": "stream_id",
      "value": "",
      "type": "string",
      "description": "Current stream ID (auto-populated)"
    }
  ],
  "item": [
    {
      "name": "🏥 Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/v1/health",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "health"]
        },
        "description": "Check API health status - no authentication required"
      },
      "response": []
    },
    {
      "name": "💬 Start Chat Conversation",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {",
              "    const response = pm.response.json();",
              "    pm.collectionVariables.set('conversation_id', response.conversation_id);",
              "    pm.collectionVariables.set('stream_id', response.stream_id);",
              "    console.log('Conversation ID:', response.conversation_id);",
              "    console.log('Stream ID:', response.stream_id);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"message\": \"Tell me about Paladine, the god of good dragons. What role does he play in Luminari lore?\",\n  \"user_id\": \"demo_user\",\n  \"metadata\": {\n    \"source\": \"postman_demo\",\n    \"session_type\": \"exploration\"\n  }\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/chat/message",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "chat", "message"]
        },
        "description": "Start a new conversation with the chat agent. Returns conversation ID and streaming URL."
      },
      "response": []
    },
