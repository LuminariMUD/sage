# ============================================
# Luminari Sage - Environment Configuration
# ============================================
# Copy this file to .env and update with your actual values
# Command: cp .env.example .env
# Security: chmod 600 .env (restrict to owner read/write only)

# ============================================
# LLM Provider Configuration
# ============================================
# Primary provider selection (REQUIRED)
# Options: openai, ollama
# openai = Cloud-based OpenAI models (paid, fast, high quality)
# ollama = Local models via Ollama (free, private, requires GPU)
LLM_PROVIDER=ollama

# ============================================
# Ollama Configuration (if LLM_PROVIDER=ollama)
# ============================================
# Ollama service URL (Docker service name or localhost)
OLLAMA_BASE_URL=http://ollama:11434
# Host port for the Ollama container; change if another Ollama already uses 11434
OLLAMA_HOST_PORT=11434

# Model selection for different tasks
OLLAMA_CHAT_MODEL=qwen2.5:7b
OLLAMA_CREATIVE_MODEL=qwen2.5:7b
OLLAMA_REASONING_MODEL=deepseek-r1:8b
# Model used by tool-calling agents. Must support tool calling: chain-of-thought
# models such as deepseek-r1 cannot, and every tool call fails against them.
OLLAMA_TOOLS_MODEL=qwen2.5:7b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Ollama Performance Tuning
OLLAMA_CHAT_TEMPERATURE=0.7
OLLAMA_CREATIVE_TEMPERATURE=0.9
OLLAMA_EXTRACTION_TEMPERATURE=0.3
OLLAMA_MAX_CONTEXT_TOKENS=4096
OLLAMA_REQUEST_TIMEOUT=120
OLLAMA_EMBEDDING_BATCH_SIZE=32

# ============================================
# OpenAI Configuration (if LLM_PROVIDER=openai)
# ============================================
# Get your API key from: https://platform.openai.com/api-keys
# Required when LLM_PROVIDER=openai
# Estimated cost: $50-100/month for moderate usage
OPENAI_API_KEY=

# ============================================
# Database Passwords (REQUIRED - MUST SET SECURE VALUES)
# ============================================
# ⚠️  SECURITY WARNING: These passwords are REQUIRED and MUST be changed!
# ⚠️  Database connections are rejected when these passwords are missing.
#
# Generate secure passwords with:
# python3 -c "import secrets; print(secrets.token_urlsafe(32))"

# PostgreSQL Database
POSTGRES_HOST=localhost
POSTGRES_USER=luminari
POSTGRES_PASSWORD=
POSTGRES_DB=luminari_sage
POSTGRES_PORT=5432

# Neo4j Graph Database
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_BOLT_PORT=7687
NEO4J_HTTP_PORT=7474

# ============================================
# API Configuration
# ============================================
API_HOST=0.0.0.0
API_PORT=8003
API_RELOAD=false
API_WORKERS=1
UVICORN_LOG_LEVEL=info
ROOT_PATH=

# Startup log destination inside the application container
LOG_FILE=/app/logs/startup.log

# MCP server settings (used when starting the MCP module directly)
MCP_HOST=127.0.0.1
MCP_PORT=8004

# ============================================
# API Keys (REQUIRED for Production - Generate Secure Values)
# ============================================
# Generate secure API keys with:
# python3 -c "import secrets; print(secrets.token_urlsafe(32))"

# Backend API key (for general API access)
SAGE_API_KEY=

# MCP Operations key (for MCP server operations)
SAGE_MCP_KEY=

# MCP Backend key (for MCP backend access)
SAGE_MCP_BACKEND_KEY=

# ============================================
# Paths (Container paths - do not change unless customizing)
# ============================================
LORE_DIR=/app/lore_docs

# ============================================
# Lore Source Configuration
# ============================================
# Determines which lore documents to load
# Options: canon, legends, all
# canon = Official game lore only
# legends = Non-canon/experimental lore
# all = Both canon and legends
LORE_SOURCE=canon

# ============================================
# Development Settings (Local/WSL2)
# ============================================
# Disable API key authentication for easier local testing
# SECURITY WARNING: Never set to 'true' in production!
DISABLE_AUTH=false

# Enable verbose logging
DEBUG=false

# Logging level
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Browser/API network allowlists (comma-separated)
# Add production hostnames and HTTPS origins explicitly; do not use "*" in production.
ALLOWED_HOSTS=localhost,127.0.0.1,testserver,api,luminari-api
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
MCP_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# ============================================
# Embedding Configuration
# ============================================
# Choose between local (free) or cloud (paid, faster) embeddings

# Use local embeddings (Ollama or sentence-transformers)
# true = Use local models (free, private, slower)
# false = Use OpenAI embeddings (paid, faster, requires API key)
USE_LOCAL_EMBEDDINGS=true

# Fallback to OpenAI if local provider fails (requires OPENAI_API_KEY)
FALLBACK_TO_OPENAI=false

# Use OpenAI embeddings (deprecated - use LLM_PROVIDER and USE_LOCAL_EMBEDDINGS)
# false = Use sentence-transformers (all-MiniLM-L6-v2, 384 dim, local, free)
# true = Use OpenAI ada-002 (1536 dim, API, paid ~$0.0001/1K tokens)
USE_OPENAI_EMBEDDINGS=false

# Batch size for embedding generation
# Reduce to 16 if memory constrained, increase to 64-100 for faster processing
EMBEDDING_BATCH_SIZE=32

# OpenAI embedding model (used when local embeddings are disabled)
EMBEDDING_MODEL=text-embedding-3-small

# Immutable revision of the bundled local sentence-transformers model
SAGE_SENTENCE_TRANSFORMERS_REVISION=1110a243fdf4706b3f48f1d95db1a4f5529b4d41

# ============================================
# Agent Configuration
# ============================================
# Which chat agent system to use
# Options: pydantic, langchain
# pydantic = Legacy PydanticAI streaming agent
# langchain = Modern LangChain ReAct agent with workflows
AGENT_TYPE=langchain

# Temperature for LLM responses (0.0 = deterministic, 1.0 = creative)
LLM_TEMPERATURE=0.7

# Maximum tokens for LLM responses
LLM_MAX_TOKENS=2000

# LLM model to use for chat agents
# Options: gpt-4o, gpt-4o-mini, gpt-4-turbo, gpt-3.5-turbo
LLM_MODEL=gpt-4o-mini

# ============================================
# Graphiti Configuration
# ============================================
# Graphiti provider override (defaults to LLM_PROVIDER if not set)
# Options: ollama, openai
# ollama = Use local Ollama models via OpenAI-compatible API
# openai = Use OpenAI models (requires OPENAI_API_KEY)
GRAPHITI_PROVIDER=ollama
# Anonymous dependency telemetry is opt-in for Sage deployments.
GRAPHITI_TELEMETRY_ENABLED=false

# Ollama configuration for Graphiti (when GRAPHITI_PROVIDER=ollama)
# Note: Uses OLLAMA_REASONING_MODEL and OLLAMA_EMBEDDING_MODEL from Ollama section above
# You can override them here if you want different models for Graphiti
# OLLAMA_REASONING_MODEL=deepseek-r1:8b    # Best for entity extraction
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text  # 768-dim embeddings

# OpenAI configuration for Graphiti (when GRAPHITI_PROVIDER=openai)
GRAPHITI_LLM_MODEL=gpt-4o-mini

# Entity extraction settings
GRAPHITI_EXTRACTION_TEMPERATURE=0.3        # Low temp for deterministic extraction
GRAPHITI_MAX_ENTITIES_PER_EPISODE=50       # Max entities to extract per episode
GRAPHITI_MAX_RELATIONSHIPS_PER_EPISODE=50  # Max relationships to extract per episode
GRAPHITI_BATCH_SIZE=10                     # Episodes per batch for processing

# ============================================
# LangChain Agent Configuration
# ============================================
LANGCHAIN_MODEL=gpt-4o-mini
LANGCHAIN_INTERNAL_API_BASE=http://localhost:8003
ENABLE_REACT=true
USE_LEGACY_LANGCHAIN=false

# Reflection controls
LANGCHAIN_ENABLE_REFLECTION=true
LANGCHAIN_REFLECTION_MODEL=gpt-4o-mini
LANGCHAIN_MAX_RETRIEVAL_ROUNDS=2
LANGCHAIN_CONFIDENCE_THRESHOLD=0.8

# ============================================
# LangSmith Observability (Optional)
# ============================================
# Tracing stays off unless explicitly enabled and a key is supplied.
LANGCHAIN_TRACING_V2=false
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_PROJECT=luminari-sage

# ============================================
# RAG (Retrieval-Augmented Generation) Configuration
# ============================================
# Number of documents to retrieve for RAG queries
RAG_RETRIEVAL_LIMIT=10

# Similarity threshold for vector search (0.0-1.0)
# Higher = stricter matching, Lower = broader results
RAG_SIMILARITY_THRESHOLD=0.7

# Use graph enhancement in RAG (query Neo4j for entity context)
RAG_USE_GRAPH=true

# Reciprocal Rank Fusion constant (k parameter)
# Used to combine vector and full-text search results
RRF_K=60

# ============================================
# Semantic Chunking Configuration
# ============================================
# Episode (chunk) size limits in tokens
MIN_EPISODE_TOKENS=200
MAX_EPISODE_TOKENS=500

# Overlap between consecutive episodes (as percentage)
EPISODE_OVERLAP_PERCENT=25

# ============================================
# Database Connection Pool Configuration
# ============================================
# PostgreSQL connection pool
POSTGRES_MIN_POOL_SIZE=5
POSTGRES_MAX_POOL_SIZE=20

# Neo4j connection pool
NEO4J_MAX_CONNECTION_POOL_SIZE=50

# ============================================
# Performance Tuning (Advanced)
# ============================================
# Enable/disable API request rate limiting
RATE_LIMIT_ENABLED=false
RATE_LIMIT_PER_MINUTE=60

# ============================================
# Feature Flags (Experimental)
# ============================================
# Enable experimental features
ENABLE_CONVERSATION_STORAGE=true
ENABLE_RELATIONSHIP_VALIDATION=true
ENABLE_QUEST_WORKFLOW=true
ENABLE_STORY_WORKFLOW=true

# ============================================
# Testing Configuration (Optional)
# ============================================
# Use in-memory databases for testing
TEST_MODE=false

# ============================================
# Docker Configuration (Optional)
# ============================================
# PostgreSQL Docker image version
POSTGRES_IMAGE=pgvector/pgvector:0.8.6-pg18

# Neo4j Docker image version
NEO4J_IMAGE=neo4j:2026.06.0-community

# Immutable production image. The deployment workflow writes the real digest.
SAGE_IMAGE=

# Advanced overrides for scripts/deploy_remote.sh
SAGE_TRANSFER_DIR=/tmp/luminari-sage-deploy
SAGE_DEPLOY_DIR=
SAGE_DOCKER_BIN=docker
SAGE_CURL_BIN=curl
SAGE_EXPECTED_UID=1013

# ============================================
# Backup Configuration (Optional)
# ============================================
# Backup directory path (host machine)
BACKUP_DIR=./backups

# Automatic backup schedule (cron format)
# Example: "0 2 * * *" = daily at 2 AM
# Leave empty to disable automatic backups
BACKUP_SCHEDULE=

# ============================================
# Monitoring and Observability (Optional)
# ============================================
# Enable Prometheus metrics endpoint
ENABLE_METRICS=false

# Metrics endpoint path
METRICS_PATH=/metrics

# Enable health check endpoints
ENABLE_HEALTH_CHECKS=true

# ============================================
# Notes
# ============================================
# 1. NEVER commit the actual .env file to version control
# 2. Generate strong passwords/keys for production deployments
# 3. Keep .env file permissions restricted: chmod 600 .env
# 4. Always required: POSTGRES_PASSWORD and NEO4J_PASSWORD
# 5. OPENAI_API_KEY is required only when an OpenAI-backed provider is enabled
# 6. Production requires SAGE_API_KEY, SAGE_MCP_KEY, and SAGE_MCP_BACKEND_KEY
# 7. For WSL2 deployment, see: docs/deployment/DEPLOYMENT_WSL2-UBUNTU.md
# 8. For production deployment, see: docs/deployment/DEPLOYMENT_GUIDE.md
