# ============================================
# Luminari Sage - Environment Configuration
# ============================================
# Copy this file to .env and update with your actual values
# Command: cp .env.example .env
# Security: chmod 600 .env (restrict to owner read/write only)

# ============================================
# LLM Provider Configuration
# ============================================
# Primary provider selection (REQUIRED)
# Options: ollama, openrouter, openai (deprecated direct compatibility)
# openai = Cloud-based OpenAI models (paid, fast, high quality)
# openrouter = OpenAI-compatible access with explicit routing/privacy policy
# ollama = Local models via Ollama (free, private, requires GPU)
LLM_PROVIDER=ollama
# Capability-level selectors used by the durable profile resolver. Leave a
# selector empty only when intentionally exercising legacy precedence.
TEXT_PROVIDER=ollama
EMBEDDING_PROVIDER=ollama

# ============================================
# Ollama Configuration (if LLM_PROVIDER=ollama)
# ============================================
# Ollama service URL (Docker service name or localhost)
OLLAMA_BASE_URL=http://ollama:11434
# Host port for the Ollama container; change if another Ollama already uses 11434
OLLAMA_HOST_PORT=11434

# Model selection for different tasks
OLLAMA_CHAT_MODEL=qwen2.5:7b
OLLAMA_CREATIVE_MODEL=qwen2.5:7b
OLLAMA_REASONING_MODEL=qwen2.5:3b
OLLAMA_EXTRACTION_MODEL=qwen2.5:3b
# Model used by tool-calling agents. Must support tool calling: chain-of-thought
# models such as deepseek-r1 cannot, and every tool call fails against them.
OLLAMA_TOOLS_MODEL=qwen2.5:7b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_EMBEDDING_DIMENSIONS=768

# Ollama Performance Tuning
OLLAMA_CHAT_TEMPERATURE=0.7
OLLAMA_CREATIVE_TEMPERATURE=0.9
OLLAMA_EXTRACTION_TEMPERATURE=0.3
OLLAMA_MAX_CONTEXT_TOKENS=12288
OLLAMA_REQUEST_TIMEOUT=120
OLLAMA_EMBEDDING_BATCH_SIZE=32
OLLAMA_TRANSPORT_MAX_ATTEMPTS=1
OLLAMA_TRANSPORT_RETRY_ON=transport,rate_limit
OLLAMA_RETRY_BASE_SECONDS=0.5
OLLAMA_RETRY_MAX_SECONDS=8

# Optional task-specific identity/capability overrides. Empty values inherit
# the resolver's validated model-family defaults.
OLLAMA_CHAT_PROMPT_PROFILE=
OLLAMA_CHAT_CAPABILITIES=
OLLAMA_CHAT_CONTEXT_TOKENS=
OLLAMA_CHAT_REVISION=
OLLAMA_CREATIVE_PROMPT_PROFILE=
OLLAMA_CREATIVE_CAPABILITIES=
OLLAMA_CREATIVE_CONTEXT_TOKENS=
OLLAMA_CREATIVE_REVISION=
OLLAMA_REASONING_PROMPT_PROFILE=
OLLAMA_REASONING_CAPABILITIES=
OLLAMA_REASONING_CONTEXT_TOKENS=
OLLAMA_REASONING_TEMPERATURE=
OLLAMA_REASONING_REVISION=
OLLAMA_EXTRACTION_PROMPT_PROFILE=
OLLAMA_EXTRACTION_CAPABILITIES=
OLLAMA_EXTRACTION_CONTEXT_TOKENS=
OLLAMA_EXTRACTION_REVISION=
OLLAMA_TOOLS_PROMPT_PROFILE=
OLLAMA_TOOLS_CAPABILITIES=
OLLAMA_TOOLS_CONTEXT_TOKENS=
OLLAMA_TOOLS_TEMPERATURE=
OLLAMA_TOOLS_REVISION=
OLLAMA_EMBEDDING_REVISION=
OLLAMA_EMBEDDING_INPUT_TYPE=

# ============================================
# OpenAI Configuration (if LLM_PROVIDER=openai)
# ============================================
# Get your API key from: https://platform.openai.com/api-keys
# Required when LLM_PROVIDER=openai
# Estimated cost: $50-100/month for moderate usage
OPENAI_API_KEY=
OPENAI_API_KEY_FILE=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_REQUEST_TIMEOUT=120
OPENAI_TRANSPORT_MAX_ATTEMPTS=1
OPENAI_TRANSPORT_RETRY_ON=transport,rate_limit
OPENAI_RETRY_BASE_SECONDS=0.5
OPENAI_RETRY_MAX_SECONDS=8
OPENAI_MAX_CONTEXT_TOKENS=8192
OPENAI_CHAT_MODEL=
OPENAI_CHAT_PROMPT_PROFILE=
OPENAI_CHAT_CAPABILITIES=
OPENAI_CHAT_CONTEXT_TOKENS=
OPENAI_CHAT_TEMPERATURE=
OPENAI_CHAT_REVISION=
OPENAI_CREATIVE_MODEL=
OPENAI_CREATIVE_PROMPT_PROFILE=
OPENAI_CREATIVE_CAPABILITIES=
OPENAI_CREATIVE_CONTEXT_TOKENS=
OPENAI_CREATIVE_TEMPERATURE=
OPENAI_CREATIVE_REVISION=
OPENAI_REASONING_MODEL=
OPENAI_REASONING_PROMPT_PROFILE=
OPENAI_REASONING_CAPABILITIES=
OPENAI_REASONING_CONTEXT_TOKENS=
OPENAI_REASONING_TEMPERATURE=
OPENAI_REASONING_REVISION=
OPENAI_EXTRACTION_MODEL=
OPENAI_EXTRACTION_PROMPT_PROFILE=
OPENAI_EXTRACTION_CAPABILITIES=
OPENAI_EXTRACTION_CONTEXT_TOKENS=
OPENAI_EXTRACTION_TEMPERATURE=
OPENAI_EXTRACTION_REVISION=
OPENAI_TOOLS_MODEL=
OPENAI_TOOLS_PROMPT_PROFILE=
OPENAI_TOOLS_CAPABILITIES=
OPENAI_TOOLS_CONTEXT_TOKENS=
OPENAI_TOOLS_TEMPERATURE=
OPENAI_TOOLS_REVISION=
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_EMBEDDING_BATCH_SIZE=100
OPENAI_EMBEDDING_REVISION=

# OpenRouter configuration is validated only when a selected capability uses it.
# Prefer OPENROUTER_API_KEY or OPENROUTER_API_KEY_FILE. OPENROUTER_KEY is a
# deprecated compatibility alias for one release window.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_API_KEY_FILE=
OPENROUTER_KEY=
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=Luminari Sage
OPENROUTER_REQUEST_TIMEOUT=120
OPENROUTER_TRANSPORT_MAX_ATTEMPTS=3
OPENROUTER_TRANSPORT_RETRY_ON=transport,rate_limit
OPENROUTER_RETRY_BASE_SECONDS=0.5
OPENROUTER_RETRY_MAX_SECONDS=8
OPENROUTER_MAX_CONTEXT_TOKENS=8192
OPENROUTER_CHAT_MODEL=
OPENROUTER_CHAT_PROMPT_PROFILE=
OPENROUTER_CHAT_CAPABILITIES=
OPENROUTER_CHAT_CONTEXT_TOKENS=
OPENROUTER_CHAT_TEMPERATURE=
OPENROUTER_CHAT_REVISION=
OPENROUTER_CREATIVE_MODEL=
OPENROUTER_CREATIVE_PROMPT_PROFILE=
OPENROUTER_CREATIVE_CAPABILITIES=
OPENROUTER_CREATIVE_CONTEXT_TOKENS=
OPENROUTER_CREATIVE_TEMPERATURE=
OPENROUTER_CREATIVE_REVISION=
OPENROUTER_GRAPHITI_MODEL=
OPENROUTER_REASONING_MODEL=
OPENROUTER_REASONING_PROMPT_PROFILE=
OPENROUTER_REASONING_CAPABILITIES=
OPENROUTER_REASONING_CONTEXT_TOKENS=
OPENROUTER_REASONING_TEMPERATURE=
OPENROUTER_REASONING_REVISION=
OPENROUTER_EXTRACTION_MODEL=
OPENROUTER_EXTRACTION_PROMPT_PROFILE=
OPENROUTER_EXTRACTION_CAPABILITIES=
OPENROUTER_EXTRACTION_CONTEXT_TOKENS=
OPENROUTER_EXTRACTION_TEMPERATURE=
OPENROUTER_EXTRACTION_REVISION=
OPENROUTER_TOOLS_MODEL=
OPENROUTER_TOOLS_PROMPT_PROFILE=
OPENROUTER_TOOLS_CAPABILITIES=
OPENROUTER_TOOLS_CONTEXT_TOKENS=
OPENROUTER_TOOLS_TEMPERATURE=
OPENROUTER_TOOLS_REVISION=
OPENROUTER_EMBEDDING_MODEL=
OPENROUTER_EMBEDDING_DIMENSIONS=1024
OPENROUTER_EMBEDDING_BATCH_SIZE=32
OPENROUTER_EMBEDDING_ENCODING_FORMAT=float
OPENROUTER_EMBEDDING_REVISION=
OPENROUTER_EMBEDDING_INPUT_TYPE=
OPENROUTER_TEXT_ALLOW_FALLBACKS=false
OPENROUTER_TEXT_REQUIRE_PARAMETERS=true
OPENROUTER_TEXT_DATA_COLLECTION=deny
OPENROUTER_TEXT_ZDR=false
OPENROUTER_TEXT_PROVIDER_ORDER=
OPENROUTER_TEXT_PROVIDER_ONLY=
OPENROUTER_TEXT_PROVIDER_IGNORE=
OPENROUTER_EMBEDDING_ALLOW_FALLBACKS=false
OPENROUTER_EMBEDDING_REQUIRE_PARAMETERS=true
OPENROUTER_EMBEDDING_DATA_COLLECTION=deny
OPENROUTER_EMBEDDING_ZDR=false
OPENROUTER_EMBEDDING_PROVIDER_ORDER=
OPENROUTER_EMBEDDING_PROVIDER_ONLY=
OPENROUTER_EMBEDDING_PROVIDER_IGNORE=

# ============================================
# Database Passwords (REQUIRED - MUST SET SECURE VALUES)
# ============================================
# ⚠️  SECURITY WARNING: These passwords are REQUIRED and MUST be changed!
# ⚠️  Database connections are rejected when these passwords are missing.
#
# Generate secure passwords with:
# python3 -c "import secrets; print(secrets.token_urlsafe(32))"

# PostgreSQL Database
POSTGRES_HOST=localhost
POSTGRES_USER=luminari
POSTGRES_PASSWORD=
POSTGRES_DB=luminari_sage
POSTGRES_PORT=5432

# Neo4j Graph Database
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_BOLT_PORT=7687
NEO4J_HTTP_PORT=7474

# ============================================
# API Configuration
# ============================================
API_HOST=0.0.0.0
API_PORT=8003
API_RELOAD=true
API_WORKERS=1
UVICORN_LOG_LEVEL=info
ROOT_PATH=

# Startup log destination inside the application container
LOG_FILE=/app/logs/startup.log

# MCP server settings (used when starting the MCP module directly)
MCP_HOST=127.0.0.1
MCP_PORT=8004
UI_PORT=8080

# ============================================
# API Keys (REQUIRED for Production - Generate Secure Values)
# ============================================
# Generate secure API keys with:
# python3 -c "import secrets; print(secrets.token_urlsafe(32))"

# Backend API key (for general API access)
SAGE_API_KEY=

# MCP Operations key (for MCP server operations)
SAGE_MCP_KEY=

# MCP Backend key (for MCP backend access)
SAGE_MCP_BACKEND_KEY=

# ============================================
# Paths (Container paths - do not change unless customizing)
# ============================================
LORE_DIR=/app/lore_docs

# ============================================
# Lore Source Configuration
# ============================================
# Determines which lore documents to load
# Options: canon, legends, all
# canon = Official game lore only
# legends = Non-canon/experimental lore
# all = Both canon and legends
LORE_SOURCE=canon

# ============================================
# Development Settings (Local/WSL2)
# ============================================
# Disable API key authentication for easier local testing
# SECURITY WARNING: Never set to 'true' in production!
DISABLE_AUTH=false

# Enable verbose logging
DEBUG=false

# Logging level
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Browser/API network allowlists (comma-separated)
# Add production hostnames and HTTPS origins explicitly; do not use "*" in production.
ALLOWED_HOSTS=localhost,127.0.0.1,testserver,api,luminari-api
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
MCP_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# ============================================
# Embedding Configuration
# ============================================
# Choose between local (free) or cloud (paid, faster) embeddings

# Use local embeddings (Ollama or sentence-transformers)
# true = Use local models (free, private, slower)
# false = Use OpenAI embeddings (paid, faster, requires API key)
USE_LOCAL_EMBEDDINGS=true

# Fallback to OpenAI if local provider fails (requires OPENAI_API_KEY)
FALLBACK_TO_OPENAI=false

# Use OpenAI embeddings (deprecated - use LLM_PROVIDER and USE_LOCAL_EMBEDDINGS)
# false = Use sentence-transformers (all-MiniLM-L6-v2, 384 dim, local, free)
# true = Use OpenAI ada-002 (1536 dim, API, paid ~$0.0001/1K tokens)
USE_OPENAI_EMBEDDINGS=false

# Batch size for embedding generation
# Reduce to 16 if memory constrained, increase to 64-100 for faster processing
EMBEDDING_BATCH_SIZE=32

# OpenAI embedding model (used when local embeddings are disabled)
EMBEDDING_MODEL=text-embedding-3-small

# Immutable revision of the bundled local sentence-transformers model
SAGE_SENTENCE_TRANSFORMERS_REVISION=1110a243fdf4706b3f48f1d95db1a4f5529b4d41
SENTENCE_TRANSFORMERS_MODEL=sentence-transformers/all-MiniLM-L6-v2
SENTENCE_TRANSFORMERS_DIMENSIONS=384
SENTENCE_TRANSFORMERS_BATCH_SIZE=32
SENTENCE_TRANSFORMERS_TIMEOUT=120

# ============================================
# Agent Configuration
# ============================================
# Which chat agent system to use
# Options: pydantic, langchain
# pydantic = Legacy PydanticAI streaming agent
# langchain = Modern LangChain ReAct agent with workflows
AGENT_TYPE=langchain

# Temperature for LLM responses (0.0 = deterministic, 1.0 = creative)
LLM_TEMPERATURE=0.7

# Maximum tokens for LLM responses
LLM_MAX_TOKENS=2000

# LLM model to use for chat agents
# Options: gpt-4o, gpt-4o-mini, gpt-4-turbo, gpt-3.5-turbo
LLM_MODEL=gpt-4o-mini

# ============================================
# Graphiti Configuration
# ============================================
# Deprecated coupled Graphiti override. Leave empty so the capability-specific
# selectors below inherit TEXT_PROVIDER and EMBEDDING_PROVIDER independently.
# Options: ollama, openrouter, openai
# ollama = Use local Ollama models via OpenAI-compatible API
# openai = Use OpenAI models (requires OPENAI_API_KEY)
GRAPHITI_PROVIDER=
# Empty capability overrides inherit the application-level selectors.
GRAPHITI_TEXT_PROVIDER=
GRAPHITI_EMBEDDING_PROVIDER=
GRAPHITI_TEXT_MODEL=
GRAPHITI_TEXT_MODEL_REVISION=
GRAPHITI_EMBEDDING_MODEL=
GRAPHITI_EMBEDDING_MODEL_REVISION=
GRAPHITI_EMBEDDING_DIMENSIONS=768
# Anonymous dependency telemetry is opt-in for Sage deployments.
GRAPHITI_TELEMETRY_ENABLED=false

# Ollama configuration for Graphiti (when GRAPHITI_PROVIDER=ollama)
# Note: Uses OLLAMA_REASONING_MODEL and OLLAMA_EMBEDDING_MODEL from Ollama section above
# You can override them here if you want different models for Graphiti
# OLLAMA_REASONING_MODEL=qwen2.5:3b         # Fast structured extraction on an 8 GB GPU
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text  # 768-dim embeddings

# OpenAI configuration for Graphiti (when GRAPHITI_PROVIDER=openai)
GRAPHITI_LLM_MODEL=gpt-4o-mini

# Entity extraction settings
GRAPHITI_EXTRACTION_TEMPERATURE=0.3        # Low temp for deterministic extraction
GRAPHITI_REQUEST_TIMEOUT=600               # One upstream request; transport retries are disabled
GRAPHITI_MAX_OUTPUT_TOKENS=4096             # Hard cap for local structured responses
GRAPHITI_MAX_ENTITIES_PER_EPISODE=25        # Max entities to extract per episode
GRAPHITI_MAX_RELATIONSHIPS_PER_EPISODE=25   # Max relationships to extract per episode
GRAPHITI_BATCH_SIZE=10                     # Episodes per batch for processing
# Empty disables candidate fallback.
GRAPHITI_EXTRACTION_FALLBACK_PROVIDER=
GRAPHITI_EXTRACTION_FALLBACK_MODEL=
GRAPHITI_EXTRACTION_PRIMARY_ATTEMPTS=2
GRAPHITI_EXTRACTION_FALLBACK_ATTEMPTS=1
GRAPHITI_EXTRACTION_MAX_PROVIDER_CALLS=3

# Durable graph synchronization. The profile fingerprint is computed from the
# complete secret-free contract; setting this value turns it into a drift guard.
GRAPH_SYNC_PROFILE_FINGERPRINT=
GRAPH_SYNC_PROMPT_VERSION=lore-extraction:v1
GRAPH_SYNC_SCHEMA_VERSION=graphiti-core-output:v1
GRAPH_SYNC_LEASE_SECONDS=900
GRAPH_SYNC_MAX_JOB_ATTEMPTS=3
GRAPH_SYNC_RETRY_BASE_SECONDS=60
GRAPH_SYNC_RETRY_MAX_SECONDS=3600
GRAPH_SYNC_MAX_PROVIDER_CALLS=3

# ============================================
# LangChain Agent Configuration
# ============================================
LANGCHAIN_MODEL=gpt-4o-mini
LANGCHAIN_INTERNAL_API_BASE=http://localhost:8003
ENABLE_REACT=true
USE_LEGACY_LANGCHAIN=false

# Reflection controls
LANGCHAIN_ENABLE_REFLECTION=true
LANGCHAIN_REFLECTION_MODEL=gpt-4o-mini
LANGCHAIN_MAX_RETRIEVAL_ROUNDS=2
LANGCHAIN_CONFIDENCE_THRESHOLD=0.8

# ============================================
# LangSmith Observability (Optional)
# ============================================
# Tracing stays off unless explicitly enabled and a key is supplied.
LANGCHAIN_TRACING_V2=false
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_PROJECT=luminari-sage

# ============================================
# RAG (Retrieval-Augmented Generation) Configuration
# ============================================
# Number of documents to retrieve for RAG queries
RAG_RETRIEVAL_LIMIT=10

# Similarity threshold for vector search (0.0-1.0)
# Higher = stricter matching, Lower = broader results
RAG_SIMILARITY_THRESHOLD=0.7

# Use graph enhancement in RAG (query Neo4j for entity context)
RAG_USE_GRAPH=true

# Reciprocal Rank Fusion constant (k parameter)
# Used to combine vector and full-text search results
RRF_K=60

# ============================================
# Semantic Chunking Configuration
# ============================================
# Episode (chunk) size limits in tokens
MIN_EPISODE_TOKENS=200
MAX_EPISODE_TOKENS=500

# Overlap between consecutive episodes (as percentage)
EPISODE_OVERLAP_PERCENT=25

# ============================================
# Database Connection Pool Configuration
# ============================================
# PostgreSQL connection pool
POSTGRES_MIN_POOL_SIZE=5
POSTGRES_MAX_POOL_SIZE=20

# Neo4j connection pool
NEO4J_MAX_CONNECTION_POOL_SIZE=50

# ============================================
# Performance Tuning (Advanced)
# ============================================
# Enable/disable API request rate limiting
RATE_LIMIT_ENABLED=false
RATE_LIMIT_PER_MINUTE=60

# ============================================
# Feature Flags (Experimental)
# ============================================
# Enable experimental features
ENABLE_CONVERSATION_STORAGE=true
ENABLE_RELATIONSHIP_VALIDATION=true
ENABLE_QUEST_WORKFLOW=true
ENABLE_STORY_WORKFLOW=true

# ============================================
# Testing Configuration (Optional)
# ============================================
# Use in-memory databases for testing
TEST_MODE=false

# ============================================
# Docker Configuration (Optional)
# ============================================
# PostgreSQL Docker image version
POSTGRES_IMAGE=pgvector/pgvector:0.8.6-pg18

# Neo4j Docker image version
NEO4J_IMAGE=neo4j:2026.06.0-community

# Immutable production image. The deployment workflow writes the real digest.
SAGE_IMAGE=

# Advanced overrides for scripts/deploy_remote.sh
SAGE_TRANSFER_DIR=/tmp/luminari-sage-deploy
SAGE_DEPLOY_DIR=
SAGE_DOCKER_BIN=docker
SAGE_CURL_BIN=curl
SAGE_EXPECTED_UID=1013

# ============================================
# Backup Configuration (Optional)
# ============================================
# Backup directory path (host machine)
BACKUP_DIR=./backups

# Automatic backup schedule (cron format)
# Example: "0 2 * * *" = daily at 2 AM
# Leave empty to disable automatic backups
BACKUP_SCHEDULE=

# ============================================
# Monitoring and Observability (Optional)
# ============================================
# Enable Prometheus metrics endpoint
ENABLE_METRICS=false

# Metrics endpoint path
METRICS_PATH=/metrics

# Enable health check endpoints
ENABLE_HEALTH_CHECKS=true

# ============================================
# Notes
# ============================================
# 1. NEVER commit the actual .env file to version control
# 2. Generate strong passwords/keys for production deployments
# 3. Keep .env file permissions restricted: chmod 600 .env
# 4. Always required: POSTGRES_PASSWORD and NEO4J_PASSWORD
# 5. OPENAI_API_KEY is required only when an OpenAI-backed provider is enabled
# 6. Production requires SAGE_API_KEY, SAGE_MCP_KEY, and SAGE_MCP_BACKEND_KEY
# 7. For WSL2 deployment, see: docs/deployment/DEPLOYMENT_WSL2-UBUNTU.md
# 8. For production deployment, see: docs/deployment/DEPLOYMENT_GUIDE.md
